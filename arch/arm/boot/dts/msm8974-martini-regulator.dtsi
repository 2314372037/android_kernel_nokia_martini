/*
 * Board voltage overrides from the working Martini tree. Keep the regulator
 * topology and Krait driver properties supplied by this kernel's base DTS.
 * Do not propagate the reference's unverified 150000 uV S2 initialization.
 * Leave S2 at the base DTS setting of 2150000 uV.
 */
&pm8941_s3 {
	regulator-max-microvolt = <2000000>;
	qcom,init-voltage = <2000000>;
};

&pm8941_l11 {
	regulator-min-microvolt = <1200000>;
	regulator-max-microvolt = <1200000>;
	qcom,init-voltage = <1200000>;
};

&pm8941_l17 {
	regulator-min-microvolt = <2800000>;
	regulator-max-microvolt = <2800000>;
	qcom,init-voltage = <2800000>;
};

&pm8941_l23 {
	regulator-min-microvolt = <2800000>;
	regulator-max-microvolt = <2800000>;
	qcom,init-voltage = <2800000>;
};
